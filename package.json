{
  "name": "dsh-deepseek-meme",
  "version": "0.3.5",
  "description": "DeepSeek Meme：DSH 表情包插件——GPT 绘制的默认表情 + 社区二创梗图双包，一键添加与发送，模型能读懂每个表情的含义。",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeWOO/DeepSeek-meme.git"
  },
  "homepage": "https://awesome-dsh-plugin.com/p/FeWOO/DeepSeek-meme/",
  "bugs": {
    "url": "https://github.com/FeWOO/DeepSeek-meme/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/default/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/default/**/*",
    "assets/community/**/*",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "sticker",
    "meme",
    "emoji"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
